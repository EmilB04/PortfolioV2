VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_anon_key
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key

# Edge-function-only secret (NOT a VITE_ var — never exposed to the client bundle).
# Required by supabase/functions/cloudinary-sign for the devMode upload flow.
# Set it out-of-band with the Supabase CLI:
#   supabase secrets set ADMIN_UPLOAD_SECRET=<a-long-random-string> --project-ref <project-ref>
#   supabase functions deploy cloudinary-sign
