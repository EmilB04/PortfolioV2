VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_anon_key
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key

# Edge-function-only secret (NOT a VITE_ var — never exposed to the client bundle).
# Required by supabase/functions/cloudinary-sign for the devMode upload flow.
# Set it out-of-band with the Supabase CLI:
#   supabase secrets set ADMIN_UPLOAD_SECRET=<a-long-random-string> --project-ref <project-ref>
#   supabase functions deploy cloudinary-sign

# Optional, local dev only: skips the "Admin upload secret" prompt when using devMode
# (Ctrl+Shift+D) against `npm run dev`. Must match ADMIN_UPLOAD_SECRET above exactly.
# SAFE ONLY because it's read behind `import.meta.env.DEV` — Vite strips that whole
# branch out of `npm run build` output, so it never reaches a production bundle even
# though it's VITE_-prefixed. Never set this as an env var on a hosting/CI platform
# that runs `vite build` — that would defeat the purpose.
VITE_DEV_ADMIN_UPLOAD_SECRET=same_value_as_ADMIN_UPLOAD_SECRET
