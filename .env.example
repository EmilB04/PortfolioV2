# ─── Local development (.env) ──────────────────────────────────────────────
# Copy to .env and fill in. Only VITE_-prefixed names reach the browser bundle.

# Local dev talks straight to the project; production goes through the
# first-party proxy instead (see below).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Cloudinary, for the devMode upload flow only (Ctrl+Shift+D in the browser).
# NOTE: src/lib/media.ts and src/pages/SpesificProjectPage.tsx read these as
# `import.meta.env.CLOUDINARY_*` — without a VITE_ prefix, so Vite never exposes
# them and both always fall back to their defaults ('emilber-portfolio' and '').
# Setting them changes nothing until those reads are renamed to VITE_CLOUDINARY_*.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key

# Optional, local dev only: skips the "Admin upload secret" prompt when using
# devMode against `npm run dev`. Must match ADMIN_UPLOAD_SECRET below exactly.
# SAFE ONLY because it's read behind `import.meta.env.DEV` — Vite strips that
# whole branch out of `npm run build` output, so it never reaches a production
# bundle even though it's VITE_-prefixed. Never set this on a hosting/CI
# platform that runs `vite build` — that would defeat the purpose.
VITE_DEV_ADMIN_UPLOAD_SECRET=same_value_as_ADMIN_UPLOAD_SECRET


# ─── Cloudflare Pages (Production and Preview) ─────────────────────────────
# Exactly three variables. Nothing else in this file belongs there.
#
#   SUPABASE_UPSTREAM       Text    https://<project-ref>.supabase.co
#   VITE_SUPABASE_URL       Text    https://emilb.no/api/supabase
#   VITE_SUPABASE_ANON_KEY  Secret  same anon key as above
#
# VITE_SUPABASE_URL points at functions/api/supabase/[[path]].ts on this site's
# own domain, not at *.supabase.co: calling Supabase directly from the browser
# makes its Cloudflare edge set a __cf_bm cookie on the visitor before they have
# answered the cookie banner. The proxy forwards the call, drops the visitor's
# Cookie header on the way up and strips Set-Cookie on the way back.
# SUPABASE_UPSTREAM is what that proxy forwards to.
#
# Both VITE_ values are baked in at build time — after changing them, trigger a
# new build rather than re-running an old deployment.
#
# For hosting that is not Cloudflare Pages, workers/supabase-proxy/ is the same
# proxy as a standalone Worker; it reads SUPABASE_URL and PATH_PREFIX instead.


# ─── Supabase edge functions ───────────────────────────────────────────────
# Edge-function-only secret (NOT a VITE_ var — never exposed to the client
# bundle). Required by supabase/functions/cloudinary-sign for the devMode upload
# flow. Set it out-of-band with the Supabase CLI, not in this file:
#   supabase secrets set ADMIN_UPLOAD_SECRET=<a-long-random-string> --project-ref <project-ref>
#   supabase functions deploy cloudinary-sign
#
# The Cloudinary API secret belongs here too, never in the Pages project:
#   supabase secrets set CLOUDINARY_API_SECRET=<secret> --project-ref <project-ref>
